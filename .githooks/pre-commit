#!/usr/bin/env bash
# Auto-bump de versión PATCH (1.0.0 → 1.0.1 → 1.0.2…) en cada commit.
# Para minor/major (1.1.0 / 2.0.0) edita package.json a mano antes del commit.
set -e
cd "$(git rev-parse --show-toplevel)"

# Sin cambios staged → no hay commit real
if git diff --cached --quiet; then
  exit 0
fi

node -e "
const fs = require('fs')
const pkg = JSON.parse(fs.readFileSync('package.json', 'utf8'))
const [maj, min, pat] = pkg.version.split('.').map(Number)
pkg.version = maj + '.' + min + '.' + (pat + 1)
fs.writeFileSync('package.json', JSON.stringify(pkg, null, 2) + '\n')
console.log('versión → ' + pkg.version)
"

# Mantener el lockfile sincronizado con la nueva versión
pnpm install --lockfile-only --silent 2>/dev/null || true

git add package.json pnpm-lock.yaml
