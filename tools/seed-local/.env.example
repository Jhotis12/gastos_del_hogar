# Credenciales para tools/seed-local/seed-local.sh
# Copia este archivo a .env y completa los valores.
# .env está gitignored: nunca subas credenciales reales.

# --- Opción A (recomendada): access token ---
# Dashboard → Account → Access Tokens → Generate new token (sbp_...)
SUPABASE_ACCESS_TOKEN=
# Opcional: password de la base (si falta, la CLI crea un rol temporal).
SUPABASE_DB_PASSWORD=
# Opcional: ref del proyecto (este repo usa xqfemqgokoedpenmqsmq).
SUPABASE_PROJECT_REF=xqfemqgokoedpenmqsmq

# --- Opción B (alternativa): connection string completa ---
# SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@<host>:5432/postgres

# --- Opcionales ---
# DOCKER_HOST=unix:///run/user/1000/podman/podman.sock
# SUPABASE_BIN=supabase
# LOCAL_DB_URL=postgresql://postgres:postgres@127.0.0.1:54332/postgres
# LOCAL_DB_CONTAINER=supabase_db_App-gastos
